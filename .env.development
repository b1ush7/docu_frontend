# 开发环境
# 后端地址统一为 https://documenter.perfumestore.xin
#
# 注意：这里填的是绝对 URL，浏览器会直接请求该域名（跨源），
# 因此后端 CORS 必须同时放行：
#   https://jenandygyt-web.github.io   线上前端
#   http://localhost:5173              本地 npm run dev
#
# 若不希望本地开发受 CORS 影响，可把下面一行清空（只留等号），
# 请求就会变成相对路径，由 vite.config.js 的 dev 代理转发到后端，
# 浏览器视为同源，不需要后端放行 localhost。
VITE_API_BASE_URL=https://documenter.perfumestore.xin

# 置为 1 时启用本地 Mock 适配器（无需后端即可预览界面效果）。
# 联调真实后端时必须为 0：否则 main.ts 会装载 415 行的 Mock 适配器，
# 请求根本不发到后端，登录成功也是假数据。
VITE_USE_MOCK=0
